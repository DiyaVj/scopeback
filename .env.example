# Ollama must be running locally. Install a model first, for example:
#   ollama pull qwen3.5:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=180
MAX_UPLOAD_MB=5

# Optional Hacktoberfest partner integration: Sentry agent tracing. Leave blank to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT=development
